# Event / API configuration - changes per event, set in Portainer's stack env vars
EVENT_CODE=27BR
API_BASE_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
API_KEY=your-gas-api-key

# Password protecting the local PKCS#12 signing certificate (at rest only,
# not shared with any external party). Pick your own value per deployment.
# Required: the worker refuses to start if this is blank.
PFX_PASSWORD=change-me

# Tuning (optional - leave blank for the defaults)
# Seconds between polls
POLL_INTERVAL=60
# Parallel job threads
NUM_WORKERS=4
# Skip jobs completed in the last N hours (0 disables dedup)
JOB_DEDUP_HOURS=1

# Google service account key. Use ONE of the two:
#  a) the whole key file, base64-encoded, in an env var:
#       Linux:      base64 -w0 service-account.json
#       PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#  b) a path on the host to the key file, mounted read-only (uncomment the
#     mount line in docker-compose.yml and set SERVICE_ACCOUNT_FILE)
GOOGLE_SERVICE_ACCOUNT_JSON=
# SERVICE_ACCOUNT_FILE=./service-account.json

# Only used by test_drive_access.py
SHARED_DRIVE_ID=your-shared-drive-id

# Resend Email Notifications
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# Email recipient for notifications
NOTIFY_EMAIL_TO=your-email@example.com

# Sender address (optional - must be verified in Resend, or use default)
NOTIFY_EMAIL_FROM=DocGen Worker <onboarding@resend.dev>
